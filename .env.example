# ── LawLens AI environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# One-var provider switch:
#   LLM_PROVIDER=openrouter  → uses OPENROUTER_API_KEY (default until credits run out)
#   LLM_PROVIDER=anthropic   → uses ANTHROPIC_API_KEY (switch at credits)
LLM_PROVIDER=openrouter

# OpenRouter (default provider)
OPENROUTER_API_KEY=

# Anthropic direct (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Sarvam AI — regional TTS (bulbul:v4-flash) and STT (saaras:v4, codemix)
SARVAM_API_KEY=

# Server
PORT=3000
APP_URL=http://localhost:3000
