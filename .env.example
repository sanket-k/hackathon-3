# ── LawLens AI environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# One-var provider switch:
#   LLM_PROVIDER=openrouter  → uses OPENROUTER_API_KEY (default until credits run out)
#   LLM_PROVIDER=anthropic   → uses ANTHROPIC_API_KEY (switch at credits)
LLM_PROVIDER=openrouter

# OpenRouter (default provider)
OPENROUTER_API_KEY=

# Free-tier models. These are the defaults; override to switch back to paid Claude.
# OCR needs image input, so MODEL_FAST must be multimodal.
# The small free models cannot emit the audit schema — keep the 550B for reasoning.
OPENROUTER_MODEL_FAST=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b:free

# Completion budget. Reasoning models spend a large share of this on hidden
# chain-of-thought; too low and the JSON is truncated (finish_reason: "length").
LLM_MAX_TOKENS=6000

# Send reasoning:{enabled:false}. Set to 0 only if you want the model's thinking
# trace — it roughly quadruples latency and eats the token budget.
LLM_DISABLE_REASONING=1

# Per-request LLM timeout in ms, clamped to [5000, 120000]. Free models are slow;
# 30-60s is realistic for a full audit.
LLM_TIMEOUT_MS=45000

# Anthropic direct (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Sarvam AI — regional TTS (bulbul:v4-flash) and STT (saaras:v4, codemix)
SARVAM_API_KEY=

# Server
PORT=3000
APP_URL=http://localhost:3000
